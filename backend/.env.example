# ============================
# SERVER
# ============================
PORT=4000
NODE_ENV=development
# The FRONTEND's origin (not the backend's own port) — used for CORS
# and for links in emails/redirects that should open a frontend page.
# Accepts a comma-separated list if more than one origin needs access
# (e.g. a local frontend plus a deployed one) — the session cookie
# requires real, explicit origins here, never "*".
# Local dev (matches whatever serves frontend/, e.g. VS Code Live Server): http://127.0.0.1:5500
# Render: the frontend static site's own https://*.onrender.com URL
APP_BASE_URL=http://127.0.0.1:5500

# ============================
# SUPABASE / POSTGRES
# ============================
# Direct Postgres connection string to your Supabase database
# (Project Settings -> Database -> Connection string -> URI)
DATABASE_URL=postgresql://postgres:password@db.xxxxxxxx.supabase.co:5432/postgres
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
# NEVER expose this to the frontend. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# ============================
# SESSION / SECURITY
# ============================
# 64-byte random hex string. Generate with: openssl rand -hex 64
SESSION_SECRET=
# Cookie name for the session token
SESSION_COOKIE_NAME=jr_session
# Session lifetime in minutes
SESSION_TTL_MINUTES=43200
# bcrypt cost factor
BCRYPT_SALT_ROUNDS=12

# ============================
# OTP
# ============================
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ============================
# EMAIL (RESEND)
# ============================
RESEND_API_KEY=
RESEND_FROM_EMAIL=JOB RUSH <noreply@jobrush.ng>

# ============================
# EMAIL BRANDING / SENDER IDENTITY
# ============================
# EMAIL_FROM_NAME/ADDRESS default to parsing RESEND_FROM_EMAIL above —
# only set these if you want them to differ from it.
EMAIL_FROM_NAME=
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO=
# Optional per-category senders (fall back to EMAIL_FROM_ADDRESS/RESEND_FROM_EMAIL if unset)
EMAIL_SECURITY_FROM=
EMAIL_SUPPORT_FROM=

EMAIL_BRAND_NAME=JOB RUSH
COMPANY_NAME=
COMPANY_ADDRESS=
# Publicly reachable logo URL for email headers. Leave unset to use
# the built-in text-wordmark placeholder — no template changes needed
# once you set this.
LOGO_URL=
# Only shown in the email footer if actually set — never invented.
PRIVACY_POLICY_URL=
TERMS_URL=
CONTACT_URL=
SOCIAL_FACEBOOK_URL=
SOCIAL_TWITTER_URL=
SOCIAL_LINKEDIN_URL=
SOCIAL_INSTAGRAM_URL=
# Secret used to sign one-click email-unsubscribe links. Falls back to
# SESSION_SECRET if unset — set this separately in production so
# rotating one doesn't invalidate the other's tokens.
UNSUBSCRIBE_SECRET=
# The API's own public URL (distinct from APP_BASE_URL, the frontend's
# origin) — needed so the unsubscribe link in emails hits this server
# directly rather than the frontend.
API_BASE_URL=http://localhost:4000

# Web Push (browser notifications for new messages / incoming calls).
# This is a self-generated key pair, NOT a third-party account signup —
# generate both with:
#   npx web-push generate-vapid-keys
# Leave unset to run without push notifications (everything else still
# works; push is skipped and other channels are unaffected).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@jobrush.ng

# ============================
# SMS / OTP (TERMII)
# ============================
TERMII_API_KEY=
TERMII_SENDER_ID=JobRush
TERMII_BASE_URL=https://api.ng.termii.com

# ============================
# RATE LIMITING
# ============================
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=8
ACCOUNT_LOCKOUT_THRESHOLD=6
ACCOUNT_LOCKOUT_MINUTES=30

# ============================
# LIVEKIT (audio/video interviews)
# ============================
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-project.livekit.cloud

# ============================
# PAYSTACK
# ============================
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Create this Plan in the Paystack dashboard (Payments -> Plans) at
# ₦4,000/month first, then paste its plan code here.
PAYSTACK_PRO_PLAN_CODE=
PRO_MONTHLY_PRICE_NGN=4000

# ============================
# GOOGLE OAUTH
# ============================
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must exactly match GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# ============================
# FACEBOOK LOGIN
# ============================
# Create an app + "Facebook Login" product at https://developers.facebook.com/apps
# Valid OAuth Redirect URI must exactly match FACEBOOK_REDIRECT_URI below.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:4000/api/auth/facebook/callback

# ============================
# SIGN IN WITH APPLE
# ============================
# Configure a Services ID (not the App ID) for "Sign in with Apple" at
# https://developer.apple.com/account/resources/identifiers/list/serviceId
# APPLE_CLIENT_ID is that Services ID. APPLE_TEAM_ID is your Apple
# Developer Team ID. APPLE_KEY_ID and APPLE_PRIVATE_KEY come from a
# key generated under Certificates, Identifiers & Profiles > Keys with
# "Sign in with Apple" enabled -- APPLE_PRIVATE_KEY is that key's .p8
# file content, with real newlines replaced by literal \n since env
# vars can't hold multi-line values directly.
# The redirect URI must exactly match APPLE_REDIRECT_URI below, AND
# must use response_mode=form_post (already hardcoded server-side).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=http://localhost:4000/api/auth/apple/callback

# ============================
# GEMINI (smart matching)
# ============================
# Get a key at https://aistudio.google.com/app/apikey
# Smart matching gracefully falls back to rule-based ranking if unset.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ============================
# VIDEO PROCESSING (portfolio work videos)
# ============================
# Uses the bundled ffmpeg-static/ffprobe-static binaries — no system
# ffmpeg install required. Defaults shown are what the app already
# falls back to if these are left unset.
# Largest SOURCE upload accepted before compression (bytes) — protects
# the server from someone submitting a huge file just to have it processed.
VIDEO_MAX_SOURCE_BYTES=524288000
# Target size the compressor aims for (bytes) — kept below the hard
# limit as a safety margin, since bitrate-based encoding only
# approximates a target file size.
VIDEO_TARGET_BYTES=50331648
# Hard ceiling for the FINAL uploaded video (bytes) — matches
# Supabase Storage's own project-wide limit; nothing larger could be
# stored regardless of this setting.
VIDEO_HARD_LIMIT_BYTES=52428800
# Max simultaneous transcode jobs this process will run at once.
VIDEO_MAX_CONCURRENT_PROCESSING=2
# Kills a transcode that runs longer than this (milliseconds).
VIDEO_PROCESSING_TIMEOUT_MS=300000
