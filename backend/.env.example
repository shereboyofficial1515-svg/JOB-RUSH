# ============================
# SERVER
# ============================
PORT=4000
NODE_ENV=development
APP_BASE_URL=http://localhost:4000
COOKIE_DOMAIN=localhost

# ============================
# SUPABASE / POSTGRES
# ============================
# Direct Postgres connection string to your Supabase database
# (Project Settings -> Database -> Connection string -> URI)
DATABASE_URL=postgresql://postgres:password@db.xxxxxxxx.supabase.co:5432/postgres
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
# NEVER expose this to the frontend. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# ============================
# SESSION / SECURITY
# ============================
# 64-byte random hex string. Generate with: openssl rand -hex 64
SESSION_SECRET=
# Cookie name for the session token
SESSION_COOKIE_NAME=jr_session
# Session lifetime in minutes
SESSION_TTL_MINUTES=43200
# bcrypt cost factor
BCRYPT_SALT_ROUNDS=12

# ============================
# OTP
# ============================
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ============================
# EMAIL (RESEND)
# ============================
RESEND_API_KEY=
RESEND_FROM_EMAIL=JOB RUSH <noreply@jobrush.ng>

# ============================
# SMS / OTP (TERMII)
# ============================
TERMII_API_KEY=
TERMII_SENDER_ID=JobRush
TERMII_BASE_URL=https://api.ng.termii.com

# ============================
# RATE LIMITING
# ============================
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=8
ACCOUNT_LOCKOUT_THRESHOLD=6
ACCOUNT_LOCKOUT_MINUTES=30

# ============================
# LIVEKIT (audio/video interviews)
# ============================
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-project.livekit.cloud

# ============================
# PAYSTACK
# ============================
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Create this Plan in the Paystack dashboard (Payments -> Plans) at
# ₦4,000/month first, then paste its plan code here.
PAYSTACK_PRO_PLAN_CODE=
PRO_MONTHLY_PRICE_NGN=4000

# ============================
# GOOGLE OAUTH
# ============================
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must exactly match GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# ============================
# GEMINI (smart matching)
# ============================
# Get a key at https://aistudio.google.com/app/apikey
# Smart matching gracefully falls back to rule-based ranking if unset.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
